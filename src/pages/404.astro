---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const _base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0,-1) : import.meta.env.BASE_URL;
---

<Layout title="404 - ColinGamez" description="That page doesn't exist.">
  <Navbar />
  
  <main class="min-h-screen flex items-center justify-center px-4 relative" style={`background-image:url(${_base}/aero/hero-aurora.jpg);background-size:cover;background-position:center`}>
    <div class="text-center max-w-2xl mx-auto aero-glass px-10 py-12">
      <img src={`${_base}/aero/nanami-start.png`} alt="Nanami start orbs" width="54" height="162" class="mx-auto mb-6" loading="eager" />
      <h1 class="text-7xl font-bold text-sky-900 mb-2">404</h1>
      <p class="text-xl text-sky-900/80 mb-8">
        That page isn't here. I either moved it, renamed it, or never made it.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={import.meta.env.BASE_URL + '/'}
          class="btn-primary inline-flex items-center space-x-2 justify-center"
        >
          <span>Back to the front page</span>
        </a>
        
        <a
          href={import.meta.env.BASE_URL + '/projects/'}
          class="btn-secondary inline-flex items-center space-x-2 justify-center"
        >
          <span>Browse my code instead</span>
        </a>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>
