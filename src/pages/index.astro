---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import VS2010Window from '../components/VS2010Window.astro';
import Gadgets from '../components/Gadgets.astro';

// Import config for personal info
const config = await import('../../data/config.json');
const personalInfo = config.default.personalInfo;
const socialLinks = config.default.socialLinks;

// Use base for image path (public/ served under BASE_URL on GH Pages)
const baseUrl = import.meta.env.BASE_URL;
const cleanBase = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
const avatarPath = `${cleanBase}${personalInfo.photo}`;
const socialIcons = {
  YouTube: 'youtube',
  GitHub: 'github',
  Twitter: 'x',
  Twitch: 'twitch',
  Discord: 'discord',
};
---

<Layout title="ColinGamez - developer, gamer">
  <Navbar />
  
  <main>
    <!-- Hero: short and human -->
    <section class="relative px-4 sm:px-6 lg:px-8 pt-14 pb-10 overflow-hidden" style={`background-image:url(${cleanBase}/aero/hero-aurora.jpg);background-size:cover;background-position:center`}>
      <div class="max-w-4xl mx-auto relative flex flex-col sm:flex-row items-center gap-6">
        <img src={avatarPath} alt="Colin" width="128" height="128" loading="eager"
          class="w-28 h-28 rounded-full object-cover shrink-0"
          style="border:3px solid #fff;box-shadow:0 0 0 2px #29B6F6,0 8px 32px rgba(2,136,209,0.5)"
          onerror="this.onerror=null;this.src='https://github.com/ColinGamez.png'" />
        <div class="aero-glass px-7 py-6 text-left w-full">
          <h1 class="text-3xl sm:text-4xl font-bold text-sky-900 leading-tight">
            ColinGamez
          </h1>
          <p class="text-sky-900/80 mt-2">
            Developer and gamer. I build web apps and little tools, post gaming stuff on YouTube, and stream on Twitch. This site is my corner — code, downloads, and a lot of 2010.
          </p>
          <div class="flex flex-wrap gap-2 mt-4">
            {socialLinks.map(link => (
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="btn-secondary text-sm inline-flex items-center gap-2">
                <img src={`${cleanBase}/aero/icons/langs/${socialIcons[link.name]}.svg`} alt="" width="16" height="16" class="w-4 h-4" loading="lazy" />
                {link.name}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- VS2010 start page: the centerpiece -->
    <section class="py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">
        <VS2010Window />
        <div class="aero-glass mt-6 px-6 py-5 flex flex-wrap items-center justify-center gap-6">
          <img src={`${cleanBase}/aero/icons/vs2010-48.png`} alt="Visual Studio 2010" width="48" height="48" class="w-12 h-12 hover:scale-110 transition-transform" title="Visual Studio 2010" loading="lazy" />
          <img src={`${cleanBase}/aero/icons/games.png`} alt="Xbox 360" width="48" height="48" class="w-12 h-12 hover:scale-110 transition-transform" title="Xbox 360" loading="lazy" />
          <img src={`${cleanBase}/aero/icons/ea-games.png`} alt="EA Games" width="48" height="48" class="w-12 h-12 hover:scale-110 transition-transform" title="EA Games" loading="lazy" />
          <img src={`${cleanBase}/aero/icons/minecraft.png`} alt="Minecraft" width="48" height="48" class="w-12 h-12 hover:scale-110 transition-transform" title="Minecraft" loading="lazy" />
          <img src={`${cleanBase}/aero/icons/roblox.png`} alt="Roblox" width="48" height="48" class="w-12 h-12 hover:scale-110 transition-transform" title="Roblox" loading="lazy" />
          <img src={`${cleanBase}/aero/icons/roblox-studio.png`} alt="Roblox Studio" width="48" height="48" class="w-12 h-12 hover:scale-110 transition-transform" title="Roblox Studio" loading="lazy" />
          <img src={`${cleanBase}/aero/icons/steam.png`} alt="Steam" width="48" height="48" class="w-12 h-12 hover:scale-110 transition-transform" title="Steam" loading="lazy" />
          <img src={`${cleanBase}/aero/icons/discord.png`} alt="Discord" width="48" height="48" class="w-12 h-12 hover:scale-110 transition-transform" title="Discord" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- My stuff: two doors, plain words -->
    <section class="py-8">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-white mb-5" style="text-shadow:0 2px 8px rgba(1,87,155,0.9)">My stuff</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <a href={`${import.meta.env.BASE_URL}projects/`} class="card p-7 hover:scale-[1.02] transition-all duration-300 group tech-glow block">
            <div class="flex items-center space-x-4 mb-3">
              <img src={`${cleanBase}/aero/icons/langs/github.svg`} alt="GitHub" width="48" height="48" class="w-12 h-12" loading="lazy" />
              <h3 class="text-xl font-bold text-sky-900 group-hover:text-sky-600 transition-colors">Code I've put on GitHub</h3>
            </div>
            <p class="text-sky-900/70 text-sm">Web apps, game experiments, tools. Sorted by stars, updated live from my profile.</p>
          </a>
          <a href={`${import.meta.env.BASE_URL}downloads/`} class="card p-7 hover:scale-[1.02] transition-all duration-300 group tech-glow block">
            <div class="flex items-center space-x-4 mb-3">
              <img src={`${cleanBase}/aero/icons/files.png`} alt="" width="48" height="48" class="w-12 h-12" loading="lazy" />
              <h3 class="text-xl font-bold text-sky-900 group-hover:text-sky-600 transition-colors">Files you can grab</h3>
            </div>
            <p class="text-sky-900/70 text-sm">Things I made for the community. Free, no account, no nonsense.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- Toolbox as Solution Explorer, not a card farm -->
    <section class="py-8 px-4 sm:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-5" style="text-shadow:0 2px 8px rgba(1,87,155,0.9)">Toolbox</h2>
        <div class="vs2010-explorer">
          <div class="vs2010-explorer-title">Solution Explorer — toolbox</div>
          <ul class="vs2010-tree">
            <li><span class="fld">Languages</span>
              <ul>
                <li><img src={`${cleanBase}/aero/icons/langs/python.svg`} alt="Python" width="16" height="16" class="w-4 h-4" /> Python</li>
                <li><img src={`${cleanBase}/aero/icons/langs/javascript.svg`} alt="JavaScript" width="16" height="16" class="w-4 h-4" /> JavaScript</li>
              </ul>
            </li>
            <li><span class="fld">Frontend</span>
              <ul>
                <li><img src={`${cleanBase}/aero/icons/langs/react.svg`} alt="React" width="16" height="16" class="w-4 h-4" /> React</li>
                <li><img src={`${cleanBase}/aero/icons/langs/tailwindcss.svg`} alt="Tailwind CSS" width="16" height="16" class="w-4 h-4" /> Tailwind CSS</li>
                <li><img src={`${cleanBase}/aero/icons/langs/astro.svg`} alt="Astro" width="16" height="16" class="w-4 h-4" /> Astro</li>
              </ul>
            </li>
            <li><span class="fld">Tools</span>
              <ul>
                <li><img src={`${cleanBase}/aero/icons/langs/nodedotjs.svg`} alt="Node.js" width="16" height="16" class="w-4 h-4" /> Node.js</li>
                <li><img src={`${cleanBase}/aero/icons/langs/git.svg`} alt="Git" width="16" height="16" class="w-4 h-4" /> Git</li>
              </ul>
            </li>
            <li><span class="fld">Off the clock</span>
              <ul>
                <li><img src={`${cleanBase}/aero/icons/games.png`} alt="" width="16" height="16" class="w-4 h-4" /> Game dev + Xbox 360 shelf above</li>
                <li><img src={`${cleanBase}/aero/icons/media.png`} alt="" width="16" height="16" class="w-4 h-4" /> Video editing</li>
                <li><img src={`${cleanBase}/aero/icons/langs/twitch.svg`} alt="Streaming" width="16" height="16" class="w-4 h-4" /> Streaming bits</li>
              </ul>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- @ water band -->
    <section class="relative h-28 my-8 overflow-hidden" style={`background-image:url(${cleanBase}/aero/aqua-1.jpg);background-size:cover;background-position:center`}>
      <div class="absolute inset-0 bg-sky-900/10"></div>
    </section>

    <Gadgets />

    <!-- Nanami, short version -->
    <section class="pb-14 px-4 sm:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto aero-glass overflow-hidden">
        <div class="grid md:grid-cols-2">
          <img src={`${cleanBase}/aero/nanami-1.jpg`} alt="Madobe Nanami" class="w-full h-64 md:h-full object-cover" loading="lazy" />
          <div class="p-7 md:p-9">
            <h2 class="text-2xl font-bold text-sky-900 mb-3">Yeah, there's a talking Nanami on this site</h2>
            <p class="text-sky-900/75 text-sm mb-3">Bottom-right corner — click her and she talks (real voice clip from the old SoraTan desktop mascot). The boot animation up top is converted from a real Nanami boot skin too.</p>
            <p class="text-sky-900/60 text-xs">Art: Madobe Nanami themepack (Microsoft Japan). Boot skin: dark13th. @ waters: Asadal stock.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <style>
    .vs2010-explorer { background: #fff; border: 1px solid #1b4f72; border-radius: 8px; overflow: hidden; box-shadow: 0 12px 40px rgba(1,87,155,0.4); font-family: 'Segoe UI', sans-serif; }
    .vs2010-explorer-title { padding: 6px 12px; font-size: 12px; color: #fff; background: linear-gradient(to bottom, #5cbcec, #0d4e86); text-shadow: 0 1px 2px rgba(0,0,0,0.6); }
    .vs2010-tree { list-style: none; margin: 0; padding: 12px 16px; font-size: 14px; color: #1e1e1e; }
    .vs2010-tree ul { list-style: none; margin: 2px 0 8px 18px; padding-left: 12px; border-left: 1px dotted #a9cfe8; }
    .vs2010-tree li { margin: 3px 0; display: block; }
    .vs2010-tree li li { display: flex; align-items: center; gap: 8px; }
    .vs2010-tree .fld { font-weight: 600; color: #0d4e86; }
    .vs2010-tree .fld::before { content: '▾ '; color: #1d6fae; }
  </style>
  
  <Footer />
</Layout>
