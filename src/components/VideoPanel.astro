---
// Fresh off my channels: latest @コリンさんYT uploads (via our worker, which
// reads the public channel RSS — no API key) plus the Twitch player, which
// shows the stream live whenever it's on. Vanilla JS, no new dependencies.
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
const config = await import('../../data/config.json');
const mini = await import('../../data/minipaso.json');
const workerUrl = mini.default.workerUrl;
const channelUrl = config.default.socialLinks.find(l => l.name === 'YouTube').url;
const twitch = config.default.socialLinks.find(l => l.name === 'Twitch');
const twitchChannel = twitch ? twitch.url.split('/').filter(Boolean).pop() : 'colin905';
---
<section id="videos" class="py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-2xl font-bold text-white mb-1" style="text-shadow:0 2px 8px rgba(1,87,155,0.9)">Fresh off my channels</h2>
    <p class="text-white/75 text-sm mb-5" style="text-shadow:0 1px 4px rgba(1,87,155,0.8)">Latest uploads from the YouTube channel, and Twitch whenever it's live.</p>
    <div class="grid lg:grid-cols-2 gap-6">
      <div class="aero-glass p-5">
        <h3 class="text-lg font-bold text-sky-900 mb-3">YouTube — latest uploads</h3>
        <div id="yt-list" class="yt-list"><p class="text-sky-900/70 text-sm">Loading from the channel feed…</p></div>
        <a href={channelUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary text-sm mt-4 inline-block">Open the channel</a>
      </div>
      <div class="aero-glass p-5">
        <h3 class="text-lg font-bold text-sky-900 mb-3">Twitch — {twitchChannel}</h3>
        <div class="twitch-frame">
          <iframe src={`https://player.twitch.tv/?channel=${twitchChannel}&parent=ColinGamez.github.io&parent=localhost&autoplay=false`} allowfullscreen scrolling="no" title="Twitch stream"></iframe>
        </div>
        <p class="text-sky-900/70 text-sm mt-3">If I'm live, it plays here. If not, the videos on the left don't expire.</p>
      </div>
    </div>
  </div>
</section>
<style>
  .yt-list { display: flex; flex-direction: column; gap: 10px; }
  .yt-card { display: flex; gap: 12px; align-items: center; text-decoration: none; padding: 6px; border-radius: 10px; }
  .yt-card:hover { background: rgba(255,255,255,0.5); }
  .yt-card img { width: 120px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.9); box-shadow: 0 2px 8px rgba(2,136,209,0.3); }
  .yt-card h4 { font-size: 14px; font-weight: 600; color: #0c4a6e; line-height: 1.3; }
  .yt-card p { font-size: 12px; color: rgba(1,87,155,0.65); }
  .twitch-frame { position: relative; padding-top: 56.25%; border-radius: 10px; overflow: hidden; border: 1px solid rgba(255,255,255,0.9); box-shadow: 0 4px 16px rgba(2,136,209,0.3); }
  .twitch-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
<script define:vars={{ workerUrl }}>
  const list = document.getElementById('yt-list');
  fetch(workerUrl + '/api/yt/latest')
    .then(r => { if (!r.ok) throw new Error('http ' + r.status); return r.json(); })
    .then(data => {
      if (!list) return;
      if (!data || !Array.isArray(data.videos) || data.videos.length === 0) throw new Error('empty');
      list.innerHTML = '';
      data.videos.forEach(v => {
        const a = document.createElement('a');
        a.className = 'yt-card';
        a.href = v.url;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        const img = document.createElement('img');
        img.src = v.thumb;
        img.alt = '';
        img.loading = 'lazy';
        const div = document.createElement('div');
        const h = document.createElement('h4');
        h.textContent = v.title;
        const p = document.createElement('p');
        p.textContent = v.published || '';
        div.appendChild(h);
        div.appendChild(p);
        a.appendChild(img);
        a.appendChild(div);
        list.appendChild(a);
      });
    })
    .catch(() => {
      if (list) list.innerHTML = '<p class="text-sky-900/70 text-sm">Feed is down right now — the channel button below still works.</p>';
    });
</script>
